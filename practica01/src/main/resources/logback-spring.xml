<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <property name="PATH_LOGS" value="./logs" />

    <appender name="ArchivoLogs" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${PATH_LOGS}/mi-aplicacion.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${PATH_LOGS}/archived/log_%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="Consola" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %highlight(%-5level) %cyan(%logger{36}) - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="Consola" />
        <appender-ref ref="ArchivoLogs" />
    </root>

</configuration>